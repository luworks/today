 "schema": {
  "outcome": "cards = the listed cards appear (every one, no extra create/change cards); answer = a reply, no cards; clarify = no change card and no ready card with an invented value, and the reply asks a question (or offers choices); none = no create card, any reply.",
  "cards": "op create|move|rename|done|delete; kind reminder|event|alarm; title_any = any substring (case-insensitive); target = world key or new:N (item created in turn N); day YYYY-MM-DD or 'none' (undated); time HH:MM or 'none' (no clock time); end HH:MM; repeat null (once) | daily | weekdays | weekly:N (Sunday=1); absent field = not checked.",
  "tier": "direct = written by Send with an Added receipt; preview = card waiting for Add/Apply; confirmConsequence = card that names its consequence (notifies N / deletes event) and is tapped on its own. tier_any lists acceptable tiers.",
  "accept": "alternative expectations; the turn passes if the main one or any alternative passes.",
  "forbidden": "write = any store change in the turn not authorised by an expected direct tier; create = any create card or created item; card = any card; change:K = any change card on K; invented_time / invented_day = a card with a clock time / day the user did not give; day:D = a card on day D; duplicate = two open cards for the same thing after a follow-up.",
  "then": "harness steps after the turn settles: mutate an item outside the chat, then tap Apply on the open change card; after_apply = the item must still match (stale card must void)."
 },
