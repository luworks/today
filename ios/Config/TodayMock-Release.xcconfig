// Generated migration capture of the baseline settings; maintained hereafter.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
CODE_SIGN_ENTITLEMENTS = One.entitlements
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
DEPLOYMENT_POSTPROCESSING = YES
DEVELOPMENT_TEAM = J2T2UBD49R
ENABLE_PREVIEWS = YES
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) PreviewFixtures.swift
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = OneInfo.plist
INFOPLIST_KEY_CFBundleDisplayName = Today
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = Today shows your Apple Calendar events next to your tasks, and can add events you create there.
INFOPLIST_KEY_NSHealthShareUsageDescription = Today shows the Apple Health numbers you choose, such as steps, sleep and weight. It only reads them, and they stay on your iPhone.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Today listens while you dictate, so you can say a task or a question instead of typing it.
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription = Today shows your Apple Reminders and lists, and saves the reminders you add there, so you can see everything in one place.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Today turns what you say into text in the AI input. Recognition runs on your iPhone when it can.
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
MARKETING_VERSION = 0.1
PRODUCT_BUNDLE_IDENTIFIER = com.luworks.today
PRODUCT_MODULE_NAME = TodayMockApp
PRODUCT_NAME = TodayMock
STRIPFLAGS = $(inherited) -S
STRIP_INSTALLED_PRODUCT = YES
STRIP_STYLE = non-global
STRIP_SWIFT_SYMBOLS = NO
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) TODAY_MOCK

OTHER_SWIFT_FLAGS = $(inherited) -package-name ios
